# Daxko OAuth (client-credentials) — same pattern as daxko-dashboard / jcc-pos
DAXKO_CLIENT_ID=
DAXKO_CLIENT_SECRET=
DAXKO_OAUTH_SCOPE=OPS_5413

# Daxko category/tag ID for Personal Training specifically. Confirm the
# exact ID from Daxko admin — do not guess. e.g. TAG8557
REDEEM_CATEGORY_ID=

BRANCH_ID=B725

# Optional: override the hardcoded INSTRUCTORS mapping without a code
# change. JSON object of instructor_id -> instructor name, e.g.:
# INSTRUCTORS_JSON={"INS22124":"John Doe","INS22125":"Sally Jones"}
INSTRUCTORS_JSON=

# Optional tuning
CACHE_REFRESH_INTERVAL_SECONDS=86400
LOG_LEVEL=INFO
PORT=10000
